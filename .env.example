# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Node environment: development | production | test
NODE_ENV=production

# Port the Express server listens on (Nginx will proxy to this)
PORT=3000

# Long random string used to sign session cookies. Generate with e.g.:
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret

# SQLite database file (created automatically if missing)
DATABASE_URL=./data/elitequest.db

# Origin the CORS policy allows for browser clients.
# Set to your production domain, e.g. https://elitequest.example.edu
CORS_ORIGIN=http://localhost:5173

# Set to "true" only on hosting panels whose nginx intercepts *.css and *.js
# URLs before they reach Node (cPGuardX). xCloud and standard Nginx reverse
# proxies do not need this — leave unset to serve Vite's original asset URLs.
# PANEL_ASSET_REWRITE=false

# Optional bootstrap values for AI question generation (Groq).
# The admin-managed values in Dashboard -> AI Settings take precedence;
# these only apply until an admin stores a key there.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
