# Dependencies
node_modules/

# Build outputs
# dist/ is committed so panel deploys work with or without a server-side build
# step (xCloud native Node.js runs `npm run build` itself; see
# docs/DEPLOYMENT-XCLOUD.md). Source maps stay out (devtools-only).
shared/dist/**/*.map
server/dist/**/*.map
client/dist/**/*.map
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Database
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/sessions/
server/data/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# SQLite backups
backups/
